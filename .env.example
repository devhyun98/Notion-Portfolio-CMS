# Notion Portfolio CMS - 환경 변수 설정 파일

# ============================================
# Notion API 설정
# ============================================

# Notion API 키
# 발급 방법:
# 1. https://www.notion.so/my-integrations 접속
# 2. "Create new integration" 클릭
# 3. Integration name: "Notion Portfolio CMS"
# 4. "Secrets" 탭에서 Internal Integration Token 복사
NOTION_API_KEY=your_api_key_here

# Notion 데이터베이스 ID
# 확인 방법:
# 1. Notion에서 Portfolio/Contents 데이터베이스 열기
# 2. 브라우저 주소창의 URL에서 ID 추출
#    예: https://www.notion.so/abc123def456?v=xyz
#    여기서 abc123def456이 Database ID입니다.
# 3. 하이픈(-) 제거 후 사용
NOTION_DATABASE_ID=your_database_id_here

# ============================================
# 개발 환경 설정 (선택사항)
# ============================================

# 다음 환경 변수는 기본값이 설정되어 있어 선택사항입니다.
# 필요에 따라 수정할 수 있습니다.

# 캐시 시간 (초 단위, 기본값: 600초 = 10분)
# NEXT_PUBLIC_CACHE_TTL=600

# Notion API 요청 타임아웃 (밀리초 단위, 기본값: 10000ms = 10초)
# NOTION_REQUEST_TIMEOUT=10000
